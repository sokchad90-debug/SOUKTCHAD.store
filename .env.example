# ============================================================
# Sokchad — Backend Environment Configuration
# ============================================================
# Copy this file to .env and fill with your values.
# On Docker, these are set in docker-compose.yml automatically.
# ============================================================

# ── Database ──
DB_HOST=db
DB_PORT=3306
DB_NAME=sokchad
DB_USER=sokchad
DB_PASS=ChangeMe_StrongPassword123!

# ── JWT ──
# Generate with: openssl rand -hex 32
JWT_SECRET=09b1708f2f6b806fcc8688a489a98d9d5679e9b418fab8b849dc749bac499a24

# ── CORS ──
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://sokchad.com,http://localhost:8081,http://localhost:19006,http://localhost:19000,exp://localhost:8081

# ── Admin CORS ──
ADMIN_CORS_ALLOWED_ORIGINS=https://admin.sokchad.com,http://localhost:8081,http://localhost:19006

# ── Upload ──
UPLOAD_DIR=/var/www/uploads

# ── MySQL Root (for Docker init only) ──
MYSQL_ROOT_PASSWORD=ChangeMe_RootPassword123!

# ── Mobile App ──
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
EXPO_PUBLIC_API_URL=https://sokchad.com/api
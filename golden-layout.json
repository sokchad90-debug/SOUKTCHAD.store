{
  "referenceViewport": {
    "width_dp": 393,
    "height_dp": 829,
    "horizontal_padding_dp": 16
  },
  "surface": {
    "phone_width": "100%",
    "max_width_dp": 480,
    "wide_screen_alignment": "center"
  },
  "header": {
    "height_formula": "clamp(50, widthFactor * 54, 58)",
    "mirrors_in_rtl": true
  },
  "searchBar": {
    "height_formula": "clamp(44, widthFactor * 46, 50)",
    "horizontal_inset": "horizontalPadding",
    "gap_after_dp": 6
  },
  "offersBanner": {
    "visible_on_home": false
  },
  "categories": {
    "columns": 4,
    "rows": 1,
    "order_mirrors_in_rtl": true
  },
  "verifiedStores": {
    "visible_items": 3,
    "order_mirrors_in_rtl": true
  },
  "sponsoredProducts": {
    "visible_items": 3,
    "image_ratio": 1,
    "order_mirrors_in_rtl": true
  },
  "recentlyAdded": {
    "columns": 2,
    "image_height_to_width_ratio": 0.78,
    "order_mirrors_in_rtl": true
  },
  "bottomNavigation": {
    "items": 4,
    "height_dp_excluding_safe_area": 56,
    "order_mirrors_in_rtl": true
  },
  "rules": {
    "same_composition_on_all_devices": true,
    "tablet_does_not_add_columns": true,
    "section_order": [
      "header",
      "search",
      "categories",
      "verifiedStores",
      "sponsoredProducts",
      "recentlyAdded",
      "bottomNav"
    ],
    "reference_languages": ["fr", "ar"]
  }
}
